default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    # Unique, monotonically increasing build number per workflow run.
    build_number = "#{Time.now.strftime('%Y%m%d')}#{ENV.fetch('BUILD_NUMBER', '1')}"
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: build_number
    )

    xcargs = "-allowProvisioningUpdates " \
             "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH')} " \
             "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
             "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    xcargs += " DEVELOPMENT_TEAM=#{ENV['ASC_TEAM_ID']}" if ENV["ASC_TEAM_ID"] && !ENV["ASC_TEAM_ID"].empty?

    export_options = { signingStyle: "automatic" }
    export_options[:teamID] = ENV["ASC_TEAM_ID"] if ENV["ASC_TEAM_ID"] && !ENV["ASC_TEAM_ID"].empty?

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: xcargs,
      export_options: export_options
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.soneko.shogikakoi",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
